{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "forge@forge-local": true
  },
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.config/gh/**)",
      "Agent(fork)",
      "mcp__kicad-mcp-pro__lib_get_bom_with_pricing",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Edit(/evidence/**)",
      "Edit(/out/verify/**)",
      "Edit(/.forge/**)",
      "Edit(/release/**)",
      "Edit(/security/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(kicad-cli pcb export gerbers *)",
      "Bash(kicad-cli pcb export drill *)",
      "Bash(tsci push *)",
      "Bash(tsci registry *)",
      "Bash(tsci clone *)",
      "Bash(tsci import *)",
      "Bash(west flash *)",
      "Bash(openocd *)",
      "Bash(pyocd *)",
      "Bash(esptool*)",
      "Bash(STM32_Programmer_CLI *)",
      "Bash(forge release *)",
      "mcp__agentic-hil__flash",
      "mcp__agentic-hil__reset",
      "mcp__agentic-hil__project_config_create",
      "mcp__agentic-hil__project_config_set",
      "mcp__agentic-hil__project_config_adopt_hardware",
      "mcp__agentic-hil__server_upgrade",
      "Bash(/home/user/solvere-web/plugins/forge/bin/forge params set *)",
      "Bash(/home/user/solvere-web/plugins/forge/bin/forge evidence add *)",
      "Bash(/home/user/solvere-web/plugins/forge/bin/forge evidence from-checks *)"
    ],
    "allow": [
      "Bash(uv run forge-check *)",
      "Bash(/home/user/solvere-web/plugins/forge/bin/forge doctor *)",
      "Bash(/home/user/solvere-web/plugins/forge/bin/forge lint *)",
      "Bash(/home/user/solvere-web/plugins/forge/bin/forge verify *)",
      "Bash(/home/user/solvere-web/plugins/forge/bin/forge evidence list*)",
      "Bash(/home/user/solvere-web/plugins/forge/bin/forge evidence status*)",
      "Bash(/home/user/solvere-web/plugins/forge/bin/forge params get *)",
      "Bash(/home/user/solvere-web/plugins/forge/bin/forge params lint*)",
      "Bash(/home/user/solvere-web/plugins/forge/bin/forge trace *)",
      "Bash(/home/user/solvere-web/plugins/forge/bin/forge ears *)",
      "Bash(~/.forge/bin/forge-python /home/user/solvere-web/plugins/forge/skills/*/scripts/*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "docker *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.forge",
        "~/.cache/uv"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh"
      ]
    },
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "objects.githubusercontent.com",
        "conda.anaconda.org",
        "code.claude.com"
      ]
    }
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  },
  "worktree": {
    "baseRef": "head"
  }
}
