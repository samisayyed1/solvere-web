#!/usr/bin/env python3
"""forge-mcp-guard: fail-closed stdio proxy in front of a real MCP server.

Usage:

    forge-mcp-guard --server ID [--lock PATH] -- <real command argv...>

See plugins/forge/bin/README.md. Standard library only (Python 3.12+).
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

_BIN_DIR = Path(__file__).resolve().parent
_PLUGIN_ROOT = _BIN_DIR.parent  # plugins/forge
_REPO_ROOT = _PLUGIN_ROOT.parent.parent  # repo root

sys.path.insert(0, str(_PLUGIN_ROOT / "lib"))

from forge.guard import run_guard  # noqa: E402  (path must be set up first)


def _split_on_separator(argv: list[str]) -> tuple[list[str], list[str]]:
    if "--" in argv:
        idx = argv.index("--")
        return argv[:idx], argv[idx + 1 :]
    return argv, []


def main(argv: list[str] | None = None, *, repo_root: Path = _REPO_ROOT) -> int:
    raw = list(sys.argv[1:] if argv is None else argv)
    forge_args, real_argv = _split_on_separator(raw)

    parser = argparse.ArgumentParser(prog="forge-mcp-guard")
    parser.add_argument("--server", required=True, help="server id, as used in security/mcp-lock.json")
    parser.add_argument("--lock", type=Path, default=None, help="path to security/mcp-lock.json")
    ns = parser.parse_args(forge_args)

    lock_path = ns.lock if ns.lock is not None else (repo_root / "security" / "mcp-lock.json")
    return run_guard(server_id=ns.server, real_argv=real_argv, lock_path=lock_path)


if __name__ == "__main__":
    sys.exit(main())
