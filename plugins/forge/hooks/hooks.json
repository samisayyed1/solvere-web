{
  "description": "Forge plugin hooks: session status, prompt/skill hints, release-command gating, write/network guardrails, post-edit verify entrypoints, the evidence gate, reviewer verdict-schema enforcement, and compaction state snapshots (CONTRACTS.md §8, brief §3.4).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup,resume,clear,compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/_failclosed.py",
              "session_start"
            ],
            "timeout": 15,
            "statusMessage": "Forge: checking gate, evidence and doctor drift"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/_failclosed.py",
              "user_prompt_submit"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/_failclosed.py",
              "user_prompt_expansion"
            ],
            "timeout": 8
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/_failclosed.py",
              "pre_tool_use"
            ],
            "timeout": 1,
            "statusMessage": "Forge: checking guardrails"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/_failclosed.py",
              "post_tool_use"
            ],
            "timeout": 32,
            "statusMessage": "Forge: running verify entrypoints for the changed path"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/_failclosed.py",
              "stop"
            ],
            "timeout": 10,
            "statusMessage": "Forge: checking the evidence gate"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^forge:verification-evaluator$|^forge:red-team$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/_failclosed.py",
              "subagent_stop"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual,auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/_failclosed.py",
              "pre_compact"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
